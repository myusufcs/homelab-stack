# Salin menjadi .env lalu sesuaikan. JANGAN commit .env yang sudah diisi.

# --- kredensial (wajib diubah) ---
POSTGRES_DB=homelab
POSTGRES_USER=homelab
POSTGRES_PASSWORD=ganti-password-ini

GRAFANA_USER=admin
GRAFANA_PASSWORD=ganti-password-ini

# --- jaringan ---
# 127.0.0.1 = hanya bisa diakses dari mesin ini (aman untuk lab)
# 0.0.0.0   = terbuka ke jaringan — pastikan Anda memang ingin begitu
BIND_ADDR=127.0.0.1

HTTP_PORT=8080
HTTPS_PORT=8443
PROM_PORT=9090
GRAFANA_PORT=3000

# --- lain-lain ---
APP_ENV=lab
BACKUP_KEEP=7
